# Postgres connection string
DATABASE_URL=postgres://logtrack:logtrack@localhost:5432/logtrack
# Set to "require" for hosted Postgres (Neon, Supabase, Railway, RDS, ...)
# PGSSL=require

# HTTP port
PORT=3000

# Optional: protect write endpoints (POST/PATCH/DELETE). Leave empty for local use.
# Clients send:  Authorization: Bearer <token>
# API_TOKEN=change-me

# Run pending migrations on boot (default true)
AUTO_MIGRATE=true
